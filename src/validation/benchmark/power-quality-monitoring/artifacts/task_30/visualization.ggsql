VISUALISE interval_start AS x, mean_active_power_kw AS y, power_direction AS color
DRAW line
SCALE DISCRETE color
    FROM ('Positive', 'Negative')
SCALE x
    FROM ('2025-03-05 12:00:00', '2025-03-05 16:00:00')
    RENAMING * => '{:time %H:%M}'
LABEL title => 'Battery power by sign', x => 'Interval start (UTC)', y => 'Mean active power (kW)', color => 'Direction'
