@startuml
!$PERSON_LEGEND_TEXT = "Person"
!$SYSTEM_LEGEND_TEXT = "Software System"
!$EXTERNAL_SYSTEM_LEGEND_TEXT = "External System"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!pragma layout smetana

SHOW_ELEMENT_TYPE("true", "false")

title SECHA Agent - System Context

LAYOUT_TOP_DOWN()

Person(analyst, "SECHA stakeholder", "Researcher or industry professional.")

System(secha, "SECHA Agent", "Allows users to analyze, visualize and export platform data using natural language.")

System_Ext(model_provider, "LLM provider", "Provides language model capabilities.")
System_Ext(data_platform, "SECHA data platform", "Provides access to governed datasets with access permissions.")

Rel(analyst, secha, "Asks data analytics questions about platform data using")
Rel_R(secha, model_provider, "Interprets queries and generates responses using")
Rel(secha, data_platform, "Gets information about datasets from, and executes queries using")

@enduml
